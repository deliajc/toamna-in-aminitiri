# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Cheia SECRETĂ "service_role". Doar pe server — nu o pune niciodată într-o variabilă NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrare ---
# Parola pentru /admin (minimum 10 caractere; recomandat 16+).
ADMIN_PASSWORD=
# Șir aleator de minimum 32 de caractere (ex.: rezultatul comenzii: openssl rand -hex 32)
SESSION_SECRET=

# --- Site ---
# Adresa publică finală (folosită pentru codul QR)
NEXT_PUBLIC_SITE_URL=https://toamna-in-amintiri.vercel.app

# --- Opțiuni (valori implicite în paranteză) ---
# Limita per fotografie, în MB (40)
NEXT_PUBLIC_MAX_IMAGE_MB=40
# Limita per videoclip, în MB (500). Pe planul Supabase Free maximul real este 50.
NEXT_PUBLIC_MAX_VIDEO_MB=500
# Afișează o casetă de acord obligatorie înainte de trimitere (false)
NEXT_PUBLIC_REQUIRE_CONSENT=false
# După eveniment: true închide încărcările (false)
NEXT_PUBLIC_UPLOADS_CLOSED=false
# Limite anti-abuz
RATE_PER_IP_10MIN=400
RATE_GLOBAL_PER_HOUR=6000
MAX_TOTAL_FILES=20000
